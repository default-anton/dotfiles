#!/usr/bin/env python3

import argparse
import os
from pathlib import Path
import stat
import subprocess
import sys
import tempfile


def parse_args():
    parser = argparse.ArgumentParser(
        description="Open Herdr's annotation popup for a saved file or line range."
    )
    parser.add_argument("file", type=Path)
    parser.add_argument("start", nargs="?", type=int, help="first line (inclusive)")
    parser.add_argument("end", nargs="?", type=int, help="last line (inclusive)")
    args = parser.parse_args()
    if (args.start is None) != (args.end is None):
        parser.error("provide both START and END")
    if args.start is not None and not 1 <= args.start <= args.end:
        parser.error("line range must satisfy 1 <= START <= END")
    return args


def selection_text(args):
    path = args.file.expanduser().resolve(strict=True)
    text = path.read_text(encoding="utf-8")
    location = str(path)
    if args.start is not None:
        lines = text.splitlines(keepends=True)
        if args.end > len(lines):
            raise ValueError(f"{path} has only {len(lines)} lines")
        text = "".join(lines[args.start - 1:args.end])
        location += f":{args.start}-{args.end}"
    if not text.strip():
        raise ValueError("file or selected lines contain no text")
    return f"File: {location}\n\n{text}"


def write_handoff(text):
    base = os.environ.get("XDG_RUNTIME_DIR", "")
    if not base.strip():
        base = os.environ.get("TMPDIR") or "/tmp"
    directory = Path(base) / f"herdr-annotate-{os.getuid()}"
    directory.mkdir(mode=0o700, exist_ok=True)
    metadata = directory.lstat()
    if (
        not stat.S_ISDIR(metadata.st_mode)
        or metadata.st_uid != os.getuid()
        or stat.S_IMODE(metadata.st_mode) != 0o700
    ):
        raise ValueError(f"{directory} must be an owned directory with mode 700")
    temporary_path = None
    try:
        with tempfile.NamedTemporaryFile(
            mode="w", encoding="utf-8", dir=directory, delete=False
        ) as temporary:
            temporary_path = Path(temporary.name)
            temporary.write(text)
        temporary_path.replace(directory / "selection")
    finally:
        if temporary_path is not None:
            temporary_path.unlink(missing_ok=True)


def main():
    args = parse_args()
    try:
        text = selection_text(args)
        write_handoff(text)
        result = subprocess.run(
            ["herdr", "plugin", "action", "invoke", "annotate.capture"],
            check=False,
        )
        return result.returncode
    except (OSError, ValueError) as error:
        print(f"annotate: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
