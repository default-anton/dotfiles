#!/usr/bin/env bash

set -e

if [[ $# -eq 0 ]]; then
  for tool in claude pi herdr worktrunk codex; do
    "$0" "$tool"
  done
  exit
fi

tool="$1"
version="${2:-latest}"

case "$tool" in
  claude)
    mise use --global "claude-code@${version}"
    mise prune --tools claude-code
    ;;
  pi)
    # Source: https://github.com/badlogic/pi-mono/tree/main/packages/coding-agent
    mise use --global "npm:@earendil-works/pi-coding-agent@${version}"
    mise prune --tools "npm:@earendil-works/pi-coding-agent"
    ;;
  herdr)
    mise use --global "herdr@${version}"
    mise prune --tools herdr
    ;;
  worktrunk)
    mise use --global "worktrunk@${version}"
    mise prune --tools worktrunk
    ;;
  codex)
    mise use --global "npm:@openai/codex@${version}"
    mise prune --tools "npm:@openai/codex"
    ;;
  *)
    echo "Usage: update {claude|pi|herdr|worktrunk|codex} [version]"
    exit 1
    ;;
esac
