{
  "lastChangelogVersion": "0.83.0",
  "defaultThinkingLevel": "high",
  "defaultProvider": "deepseek",
  "defaultModel": "deepseek-v4-flash",
  "enabledModels": [
    "openai/gpt-5.6-luna",
    "openai/gpt-5.6-terra",
    "openai/gpt-5.6-sol",
    "deepseek-v4-flash"
  ],
  "compaction": {
